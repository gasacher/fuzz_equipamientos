generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  CLIENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CLIENT)
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Client {
  id           String        @id @default(cuid())
  clientNumber String?       @unique
  name         String        @unique
  email        String?
  phone        String?
  notes        String?
  users        User[]
  instruments  Instrument[]
  contracts    Contract[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Contract {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  type      String
  signedAt  DateTime
  fileName  String?
  filePath  String?
  createdAt DateTime @default(now())

  @@index([clientId])
}

model Instrument {
  id                String             @id @default(cuid())
  historias         String?
  categoria         String
  subcategoria      String?
  titulo            String
  valorUsd          Float?
  valorArg          Float?
  contacto          String?
  fb                Boolean            @default(false)
  ig                String?
  ml                Boolean            @default(false)
  marca             String?
  anio              String?
  origen            String?
  imageUrl          String?
  descripcion       String?
  visibleInCatalog  Boolean            @default(true)
  status            String             @default("ingresado")
  location          String?
  buyer             String?
  receiptName       String?
  receiptPath       String?
  clientId          String?
  client            Client?            @relation(fields: [clientId], references: [id])
  events            InstrumentEvent[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([categoria])
  @@index([visibleInCatalog])
  @@index([status])
  @@index([clientId])
  @@index([titulo])
}

model InstrumentEvent {
  id           String     @id @default(cuid())
  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  type         String
  title        String
  detail       String?
  createdAt    DateTime   @default(now())

  @@index([instrumentId])
  @@index([createdAt])
}

model Sale {
  id                 String   @id @default(cuid())
  historias          String?
  dia                String?
  titulo             String
  precioVentaUsd     Float?
  porcentajeComision Float?
  totalComisionFuzz  Float?
  mes                String?
  comKar             Float?
  comLean            Float?
  comFuzz            Float?
  anio               Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([mes])
  @@index([anio])
  @@index([titulo])
}

model ShowroomAppointment {
  id           String   @id @default(cuid())
  visitorName  String
  phone        String
  email        String?
  visitType    String
  interestNote String?
  scheduledAt  DateTime
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([scheduledAt])
  @@index([status])
}
