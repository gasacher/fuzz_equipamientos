{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "local": "npm run build && next start -p 3000",
    "refresh": "rm -rf .next && npm run build && npm run start",
    "demo": "npm run build && npm run start",
    "start": "next start -p 3000",
    "start:production": "sh scripts/start-production.sh",
    "postinstall": "prisma generate",
    "build": "next build",
    "build:production": "next build",
    "build:gh-pages": "node scripts/build-gh-pages.mjs",
    "lint": "eslint",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "prisma migrate deploy && npm run db:seed",
    "export:catalog": "tsx scripts/export-catalog-json.ts",
    "export:admin-demo": "tsx scripts/export-admin-demo.ts",
    "export:demo": "npm run export:catalog && npm run export:admin-demo"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "jose": "^6.2.3",
    "next": "16.2.6",
    "nodemailer": "^9.0.3",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  },
  "engines": {
    "node": "22"
  }
}
